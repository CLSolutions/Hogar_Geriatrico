# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — HOGAR GERIÁTRICO CASA TROMPO
# Copiar este archivo como ".env" dentro de /backend y completar los valores.
# ==============================================================================

# Servidor Node.js / Express
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5500

# Base de Datos MySQL 8.0+ (Motor InnoDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CasaTrompo2311*
DB_NAME=casa_trompo_db
DB_CONNECTION_LIMIT=10

# Seguridad y Autenticación (Cookies HttpOnly + JWT)
JWT_ACCESS_SECRET=reemplazar_por_cadena_aleatoria_minimo_64_caracteres_access
JWT_REFRESH_SECRET=reemplazar_por_cadena_aleatoria_minimo_64_caracteres_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# Aprovisionamiento Inicial del Administrador
ADMIN_FULL_NAME=Dirección General Casa Trompo
ADMIN_EMAIL=hgcasatrompo@gmail.com
ADMIN_PASSWORD=CasaTrompo2311*
